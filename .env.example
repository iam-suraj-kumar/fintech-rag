OPENAI_API_KEY=
# Required only when LLM_PROVIDER or EMBEDDING_PROVIDER is "gemini"
GEMINI_API_KEY=

QDRANT_URL=http://localhost:6333
# Optional: embedded Qdrant, no Docker. Set a folder (e.g. data/qdrant_local) to
# run Qdrant inside the Python process; overrides QDRANT_URL. See README.
QDRANT_PATH=

# LLM provider: "openai" (default) or "gemini" (see core/llm.py)
LLM_PROVIDER=
# Optional override; defaults to gpt-4o (openai) or gemini-3.5-flash (gemini)
LLM_MODEL=

# Embedding provider: "openai" (default) or "gemini" (see core/embeddings.py).
# Changing it changes the vector space: re-run ingestion/index_comparison_collections.py.
EMBEDDING_PROVIDER=
# Optional override; defaults to text-embedding-3-small (openai) or gemini-embedding-001 (gemini)
EMBEDDING_MODEL=
